<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.3</Version>
		<Authors>Raypro</Authors>
		<RootNamespace>Tgs.GameInterface.Kaiyuan.Client</RootNamespace>
		<PackageId>Tgs.GameInterface.Kaiyuan.Client</PackageId>
		<Title>Tgs.GameInterface.Kaiyuan.Client</Title>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-kaiyuan</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-kaiyuan.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Tgs GameInterface Kaiyuan Client</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.55.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.55.0" />
		<PackageReference Include="Grpc.Tools" Version="2.57.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Tgs.GameInterface.Kaiyuan\Protos\gameinterfacekaiyuan.proto" Link="gameinterfacekaiyuan.proto" />
	</ItemGroup>

</Project>
